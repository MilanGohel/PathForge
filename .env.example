# =============================================================================
# Pathforge — copy to .env.local and fill in real values
#   cp .env.example .env.local
# =============================================================================

# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role: server-only. Used for pack seed scripts if needed. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Vercel AI Gateway (https://vercel.com/docs/ai-gateway) ---
# Create a key in the Vercel dashboard → AI Gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Optional model overrides (gateway creator/model format)
AI_MODEL_FAST=openai/gpt-4.1-mini
AI_MODEL_STRONG=anthropic/claude-sonnet-4.6

# --- Serper web search (https://serper.dev) ---
SERPER_API_KEY=your_serper_api_key

# --- YouTube Data API v3 (optional until video enrichment) ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_data_api_key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily generation budget per user (model calls that write new content)
GENERATION_DAILY_BUDGET=40
