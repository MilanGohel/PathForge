# =============================================================================
# Pathforge — copy to .env.local and fill in real values
#   cp .env.example .env.local
# =============================================================================

# --- Supabase (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role: server-only. Used for pack seed scripts if needed. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Supabase Postgres poolers (Project Settings → Database → Connection string) ---
# Transaction pooler (port 6543) — app runtime. IPv4-friendly shared pooler.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — migrations / RLS / drizzle-kit only.
# Required for: pnpm db:migrate · pnpm db:rls
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Vercel AI Gateway (https://vercel.com/docs/ai-gateway) ---
# Create a key in the Vercel dashboard → AI Gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Models (provider/model ids as listed in the Gateway catalog)
# Default / fast path (L0, L1, diagnostic, today blurb)
AI_GATEWAY_MODEL=xiaomi/mimo-v2.5-pro
# Alias for AI_GATEWAY_MODEL (optional)
# AI_MODEL_FAST=xiaomi/mimo-v2.5-pro
# Stronger model for L2 lessons + tutor (falls back to AI_GATEWAY_MODEL if unset)
AI_MODEL_STRONG=deepseek/deepseek-v4-pro-0813

# --- Serper web search (https://serper.dev) ---
SERPER_API_KEY=your_serper_api_key

# --- YouTube Data API v3 (optional until video enrichment) ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_data_api_key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily generation budget per user (model calls that write new content)
GENERATION_DAILY_BUDGET=40
